# Copia este fichero a .env y ajusta los valores. / Copy this file to .env and adjust.

# Obligatoria fuera de desarrollo. / Required outside development.
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite (por defecto) o PostgreSQL. / SQLite (default) or PostgreSQL.
# DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://user:password@localhost:5432/glissandi
